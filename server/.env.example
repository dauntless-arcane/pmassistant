# Port the local Node server listens on
PORT=4000

# The constant routing automation's incoming webhook URL. A Rovo agent
# decides which agent id from registry.json best matches the request.
# This is separate from each agent's own automationWebhookUrl in
# registry.json.
ROVO_ROUTER_WEBHOOK_URL=https://REPLACE_WITH_YOUR_ROUTER_AUTOMATION_WEBHOOK_URL

# Optional. Sent as the X-Automation-Webhook-Token header if set.
ROVO_ROUTER_WEBHOOK_SECRET=

# Field name the router webhook payload uses for the routing prompt.
ROVO_ROUTER_INPUT_FIELD=prompt

# How long to wait for the router automation to call back with a decision
# before giving up (ms).
ROVO_ROUTER_TIMEOUT_MS=30000

# Public base URL of THIS server, as reachable by Atlassian Automation's
# outgoing webhook action (Atlassian Cloud cannot reach localhost directly).
# Use a tunnel while testing, e.g.:
#   ngrok http 4000
# then paste the https URL ngrok gives you here, e.g.
#   https://abcd1234.ngrok-free.app
PUBLIC_CALLBACK_BASE_URL=https://REPLACE_WITH_TUNNEL_URL

# Minutes before a request that never received a callback is marked expired.
PENDING_TTL_MINUTES=30

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty for same-origin only (the default; the dev proxy and Docker need nothing here).
CORS_ORIGIN=

# Max request body size.
BODY_LIMIT=1mb

# Tunnel lock-down (see README). Requests via a tunnel/proxy may only hit the
# callback endpoints from Atlassian IPs. Set "off" to disable.
CALLBACK_IP_GUARD=on

# Optional but recommended: callbacks must send this as X-Callback-Secret.
CALLBACK_SHARED_SECRET=

# Optional extra comma-separated CIDRs to allow.
CALLBACK_EXTRA_CIDRS=
