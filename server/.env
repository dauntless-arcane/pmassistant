# Port the local Node server listens on
PORT=4000

# The constant routing automation's incoming webhook URL. This replaces the
# old OpenRouter call — a Rovo agent decides which agent id from
# registry.json best matches the request, so nothing leaves the org for
# routing. This is separate from each agent's own automationWebhookUrl in
# registry.json.
ROVO_ROUTER_WEBHOOK_URL=https://api.atlassian.com/automation/sc3/o/studio/t/workspace/i/83c62286-84e6-4846-acc8-4b3b7d3101ed/webhooks/a/01a03825-3229-73ef-8998-d53ecd925548

# Optional. Sent as the X-Automation-Webhook-Token header if set.
ROVO_ROUTER_WEBHOOK_SECRET=7b557bc1b14d3d2b14a7a16cf932c53c458addbf

# Field name the router webhook payload uses for the routing prompt.
ROVO_ROUTER_INPUT_FIELD=prompt

# Public base URL of THIS server, as reachable by Atlassian Automation's
# outgoing webhook action (Atlassian Cloud cannot reach localhost directly).
# Use a tunnel while testing, e.g.:
#   ngrok http 4000
# then paste the https URL ngrok gives you here, e.g.
#   https://abcd1234.ngrok-free.app
PUBLIC_CALLBACK_BASE_URL=https://0f3s3cxm-4000.inc1.devtunnels.ms

# Disable TLS cert verification — corporate proxy injects its own CA which Node doesn't trust.
# Safe for local POC dev; remove before any production use.
NODE_TLS_REJECT_UNAUTHORIZED=0

